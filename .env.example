# Copy to .env (git-ignored) and adjust. The website and Prisma both read DATABASE_URL.
# Local PostgreSQL (Postgres.app or Homebrew), database "cinecue":
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5433/cinecue"
# Hosted (Neon, Supabase, ...): use the provider's connection string, with ?sslmode=require
